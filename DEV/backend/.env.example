# CatalogX Backend Environment Variables
# Copy to .env and fill in values

# Security
SECRET_KEY=change-me-to-a-random-string
HMAC_KEY=change-me-to-a-random-hmac-key
ALTCHA_HMAC_KEY=change-me-captcha-key

# Database (SQLite for dev, PostgreSQL for production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/catalogx
# DATABASE_URL=sqlite+aiosqlite:///./catalogx.db

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT=30/minute

# File Upload
MAX_UPLOAD_SIZE_MB=50

# AI-ML Provider
DEFAULT_PROVIDER=local
GEMINI_API_KEY=
GROQ_API_KEY=
