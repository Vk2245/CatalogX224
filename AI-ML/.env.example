# Ollama (local, primary provider for everything)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vision embedding model (runs locally via transformers, no API)
VISION_EMBED_MODEL=nomic-ai/nomic-embed-vision-v1.5

# Groq (FALLBACK ONLY -- when local quality is insufficient)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Gemini (FALLBACK ONLY -- when local cannot handle long context)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini/gemini-2.5-flash

# Paths
DATA_DIR=./data
CHROMA_DB_DIR=./data/chroma_db
REPORTS_DIR=./data/reports
CORRECTION_LOG_PATH=./data/corrections.json
